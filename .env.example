# Phase 2 - copy this file to .env and fill in real values

# Postgres connection string (get this from Railway, Supabase, Neon, or your own Postgres instance)
DATABASE_URL="postgresql://user:password@localhost:5432/truorigin?sslmode=no-verify"

# Prisma direct connection URL for migrations / Studio when using a pooler
DIRECT_URL="postgresql://user:password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require"

# Used to build QR codes, OriginCard links, canonical URLs, and the sitemap.
# Set to your real production domain (no trailing slash) - e.g. NEXT_PUBLIC_SITE_URL="https://truorigin.in"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# JWT signing secret - generate with: openssl rand -base64 32
JWT_SECRET=""

# Bootstrap admin credentials - CHANGE BOTH before deploying. This account is created
# automatically on first successful login with these values, so a weak/default password
# here is a real backdoor in production.
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="CHANGE_ME_BEFORE_DEPLOY"

# Vercel Blob (for product photo / certificate / lab report uploads)
# Generate from your Vercel dashboard: Storage -> Blob -> Create Store -> .env.local tab
BLOB_READ_WRITE_TOKEN=""

# Email service (for brand approval / rejection notifications)
EMAIL_FROM="no-reply@truorigin.in"
RESEND_API_KEY=""
